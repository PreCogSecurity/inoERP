{
    "name": "precogsecurity/inoerp",
    "description": "inoERP - Enterprise Resource Planning system",
    "type": "project",
    "require": {
        "php": ">=5.5",
        "mpdf/mpdf": "~8.0",
        "phpmailer/phpmailer": "^6.0"
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": []
        }
    },
    "autoload": {
        "psr-4": {
            "InoERP\\": "inoerp/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPMailer\\PHPMailer\\": "vendor/phpmailer/phpmailer/src/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}